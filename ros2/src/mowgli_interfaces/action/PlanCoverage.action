# Goal — per SPEC R-2 (Phase 01-coverage-planner-rewrite)
geometry_msgs/PoseStamped start_pose       # current robot pose; if header.frame_id is empty, plan starts from dock_pose
geometry_msgs/PoseStamped dock_pose        # docking pose in map frame
float32 mow_angle_offset_deg               # -1.0 = auto-rotate by angle_increment from last_mow_angle_deg (SPEC R-9)
bool resume_from_checkpoint                # true = read .kv files and continue at the open swath (SPEC R-11)
---
# Result
bool success
mowgli_interfaces/CoverageWaypoint[] plan
mowgli_interfaces/PlanMetadata metadata
mowgli_interfaces/PlanError error          # populated iff success=false
---
# Feedback
float32 progress_percent                   # 0..100
string phase                               # "areas_loaded" | "outlines_generated" | "swaths_generated" | "validation_passed"
