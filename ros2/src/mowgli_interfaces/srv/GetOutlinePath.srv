# Returns a closed-loop path along the polygon boundary of a mowing area,
# offset inward by the mower-blade radius plus a safety margin. The BT
# OutlineArea node drives this path before the strip-plan starts so the
# polygon edge gets cut — without it, strip_boundary_margin_m + the inner
# strip-spacing leave the perimeter band uncut on every run (#50).
#
# inset_m=0 selects the recommended default: mower_width/2 + 0.05 m.
# The path is closed: the last pose returns to the first vertex of the
# offset polygon, so the BT can run a single FollowPath goal end-to-end.

uint32 area_index
float32 inset_m
---
bool success
string error_message
nav_msgs/Path outline_path
float32 effective_inset_m   # the inset actually used (after the default rule)
uint32 num_vertices         # polygon vertices after the inward offset
